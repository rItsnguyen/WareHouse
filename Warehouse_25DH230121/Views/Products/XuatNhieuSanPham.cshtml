
@{
    ViewBag.Title = "Xuất nhiều sản phẩm";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Xuất nhiều sản phẩm</h2>

@using (Html.BeginForm(
    "XuatNhieuSanPham",
    "Products",
    FormMethod.Post))
{
    @Html.AntiForgeryToken()

    @Html.ValidationSummary(
        true,
        "",
        new { @class = "text-danger" }
    )

    <h4>Sản phẩm thứ nhất</h4>

    <div class="form-group">
        <label>Chọn sản phẩm</label>

        @Html.DropDownList(
            "productId1",
            (SelectList)ViewBag.Products1,
            "-- Chọn sản phẩm thứ nhất --",
            new { @class = "form-control" }
        )
    </div>

    <div class="form-group">
        <label>Số lượng xuất</label>

        <input type="number"
               name="quantity1"
               class="form-control"
               min="1"
               step="1"
               required />
    </div>

    <hr />

    <h4>Sản phẩm thứ hai</h4>

    <div class="form-group">
        <label>Chọn sản phẩm</label>

        @Html.DropDownList(
            "productId2",
            (SelectList)ViewBag.Products2,
            "-- Chọn sản phẩm thứ hai --",
            new { @class = "form-control" }
        )
    </div>

    <div class="form-group">
        <label>Số lượng xuất</label>

        <input type="number"
               name="quantity2"
               class="form-control"
               min="1"
               step="1"
               required />
    </div>

    <br />

    <button type="submit" class="btn btn-danger">
        Xuất hai sản phẩm
    </button>

    @Html.ActionLink(
        "Quay lại",
        "Index",
        "Products",
        null,
        new { @class = "btn btn-default" }
    )
}